{
  "name": "web-oneclick",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "node scripts/start-server.mjs",
    "start:next": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "sync:odoo": "tsx scripts/sync-odoo.ts",
    "sync:stock": "tsx scripts/sync-stock.ts",
    "sync:gallery": "tsx scripts/sync-product-gallery.ts",
    "sync:home-images": "tsx scripts/sync-home-images.ts",
    "assets:download": "node scripts/download-assets.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "mercadopago": "^3.2.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
